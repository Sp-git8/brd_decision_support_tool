{UTF-8}
Actual feed intake=Target feed intake * (1 - 0.4 * Stress / (Stress + 3)) * (1 - 0.5 \
		* BRD probability)
	~	
	~		|

Antibiotic doses=Head count * Use Metaphylaxis + Expected cases
	~	
	~		|

Arrival Stress=(0.05 * Transport hours + Channel stress + Commingling stress + Weaning stress\
		) * PULSE(0, 1)
	~	
	~		|

Arrival Weight=550
	~	lb [350,850,10]
	~		|

BRD probability=1 - EXP(-Cumulative hazard)
	~	
	~		|

Channel stress=1.5
	~	index [0,1.5,0.1]
	~		|

Commingling stress=0.8
	~	index [0,1.5,0.1]
	~		|

Crowding effect=1
	~	multiplier [0.7,1.4,0.05]
	~		|

Cumulative hazard= INTEG (Daily BRD hazard,
		0)
	~	
	~		|

Daily BRD hazard=DELAY3(0.0075 * Exposure effect * EXP(0.3 * Stress - 2 * Immunity + \
		0.5 * Nutrition Deficit) * (1 - 0.5 * Metaphylaxis active), 7)
	~	
	~		|

Deficit growth=MAX(0, Target feed intake - Actual feed intake) / Target feed intake
	~	
	~		|

Deficit recovery=Nutrition Deficit / 4
	~	
	~		|

Expected cases=Head count * BRD probability
	~	
	~		|

Expected deaths= Expected cases * 0.07
	~	
	~		|

Exposure effect=1.3
	~	multiplier [1,1.6,0.1]
	~		|

Head count=200
	~	head [20,500,10]
	~		|

Immunity= INTEG (Immunity gain-Immunity loss,
		0.55)
	~	
	~		|

Immunity gain=Vaccination boost + 0.05 * (1 - Immunity) * (1 - MIN(Nutrition Deficit \
		/ 3, 1))
	~	
	~		|

Immunity loss=0.02 * Stress * Immunity
	~	
	~		|

Metaphylaxis active=Use Metaphylaxis * IF THEN ELSE(Time < 7, 1, 0)
	~	
	~		|

Moisture = WITH LOOKUP (Time,
		 ([(0,0)-(45,1)],(0,0),(7.99,0),(8,0.3),(10.99,0.3),(11,0),(45,0)))
	~	inches [0,1]
	~		|

Nutrition Deficit= INTEG (Deficit growth-Deficit recovery,
		0)
	~	
	~		|

Stress= INTEG (Stress gain-Stress recovery,
		0)
	~	
	~		|

Stress gain=Crowding effect * (Arrival Stress + Weather Stress)
	~	
	~		|

Stress recovery= Stress / 5
	~	
	~		|

Target feed intake=0.02 * Arrival Weight
	~	
	~		|

Temperature = WITH LOOKUP (Time,
		 ([(0,0)-(45,50)],(0,22),(7.99,22),(8,45),(10.99,45),(11,22),(45,22)))
	~	F [10,45]
	~		|

Total cost= 25 * (Antibiotic doses - Expected cases) + 140 * Expected cases + 1500 * \
		Expected deaths
	~	
	~		|

Transport hours=10
	~	hours [0,36,1]
	~		|

Use Metaphylaxis=0
	~	 [0,1,1]
	~		|

vaccinated=0
	~	switch [0,1,1]
	~		|

Vaccination boost=DELAY3(0.2 * vaccinated * PULSE(0, 1), 12)
	~	
	~		|

Weaning stress=1
	~	index [0,2,0.5]
	~		|

Weather Stress= 0.05 * MAX(0, Temperature - 30) + 0.03 * MAX(0, Wind - 20) + 0.5 * IF THEN ELSE\
		(Moisture > 0.1, 1, 0)
	~	
	~		|

Wind = WITH LOOKUP (Time,
		 ([(0,0)-(45,40)],(0,12),(7.99,12),(8,30),(10.99,30),(11,12),(45,12)))
	~	mph [0,35]
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 45
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Day [0,?]
	~	The time step for the simulation.
	|

